<Window x:Class="RazerBookRgb.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Razer Book RGB" Icon="/Assets/App.ico" Width="1040" Height="720" MinWidth="940" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#101214" Foreground="#F0F3F5" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#98A1AB"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#292E34"/><Setter Property="Foreground" Value="#F0F3F5"/><Setter Property="BorderBrush" Value="#414850"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#82EB71"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E2E7EB"/><Setter Property="Margin" Value="0,5"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#101214"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#414850"/><Setter Property="Padding" Value="7,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="Slider"><Setter Property="Margin" Value="0,4,0,8"/><Setter Property="IsMoveToPointEnabled" Value="True"/></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#24292F"/><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/></Style>
    </Window.Resources>
    <Grid Margin="18,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="BOOK / RGB" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="RAZER BOOK 13" Foreground="#82EB71" FontSize="10" Margin="16,9,0,0"/></StackPanel>
            <Button Content="Settings" HorizontalAlignment="Right" Click="Settings_Click"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                <StackPanel>
                    <Border Background="#1A1E22" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PROFILES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <Grid x:Name="ProfileControls">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="ProfileBox" IsEditable="True" MaxDropDownHeight="240" Foreground="#101214" Padding="6,4" ToolTip="Choose a saved profile or type a name to save a new one.">
                                    <ComboBox.Resources><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Foreground" Value="#101214"/><Setter Property="Background" Value="White"/></Style></ComboBox.Resources>
                                </ComboBox>
                                <Button x:Name="SaveProfileButton" Grid.Column="1" Content="Save profile" Click="SaveProfile_Click" Margin="6,0,0,0"/>
                                <Button x:Name="LoadProfileButton" Grid.Column="2" Content="Load" Click="LoadProfile_Click" Margin="6,0,0,0"/>
                            </Grid>
                            <TextBlock Text="Save the current settings under a name. Load applies them immediately." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button x:Name="StaticButton" Content="Static color" Click="Static_Click" Margin="0,0,4,0"/>
                        <Button x:Name="CustomButton" Grid.Column="1" Content="Per-key color" Click="Custom_Click" Margin="4,0,0,0"/>
                    </Grid>
                    <Border Background="#1A1E22" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="ModeHint" Margin="0,0,0,10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <Viewbox Stretch="Uniform"><StackPanel x:Name="KeyboardPanel" Width="750"/></Viewbox>
                            <TextBlock x:Name="SelectionText" Margin="0,8,0,6" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <WrapPanel x:Name="SelectionTools"><Button Content="Select all" Click="SelectAll_Click" Margin="0,0,6,0"/><Button Content="Clear" Click="ClearSelection_Click" Margin="0,0,6,0"/><Button Content="Paint selected" Click="Paint_Click"/></WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="SettingsCard" Background="#1A1E22" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Lights off after no key press" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox x:Name="IdleTimeoutBox" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="IdleTimeout_Changed" Padding="8,5" Foreground="#101214" Background="#E5E9EC" ToolTip="Keyboard inactivity only. Mouse movement does not reset the timer.">
                                    <ComboBoxItem Content="Never" Tag="0"/><ComboBoxItem Content="5 seconds" Tag="5"/><ComboBoxItem Content="15 seconds" Tag="15"/><ComboBoxItem Content="30 seconds" Tag="30"/><ComboBoxItem Content="1 minute" Tag="60"/><ComboBoxItem Content="2 minutes" Tag="120"/><ComboBoxItem Content="5 minutes" Tag="300"/><ComboBoxItem Content="10 minutes" Tag="600"/><ComboBoxItem Content="30 minutes" Tag="1800"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock x:Name="IdleStatusText" Text="Next key press restores lighting. Keep the app running in the tray." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8"/>
                            <Separator Background="#343B43" Margin="0,0,0,5"/>
                            <CheckBox x:Name="LoginCheck" Content="Start at Windows login (in tray)" Click="Login_Click"/>
                            <CheckBox x:Name="RestoreCheck" Content="Restore saved lighting on launch and wake" Click="Preferences_Click"/>
                            <CheckBox x:Name="TrayCheck" Content="Close window to tray" Click="Preferences_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" Background="#1A1E22" CornerRadius="8" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <TextBlock Text="COLOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                    <Border x:Name="Swatch" Height="38" CornerRadius="5" Margin="0,8,0,8"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="HexBox" MaxLength="7" TextChanged="Hex_Changed" ToolTip="Hex color: #RRGGBB"/><Button Grid.Column="1" Content="Pick…" Click="Pick_Click" Margin="6,0,0,0" Padding="10,5"/></Grid>
                    <TextBlock x:Name="ColorError" Foreground="#FFB18B" FontSize="10" MinHeight="14" Margin="0,2,0,3"/>
                    <TextBlock x:Name="RedLabel"/><Slider x:Name="RedSlider" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Rgb_Changed"/>
                    <TextBlock x:Name="GreenLabel"/><Slider x:Name="GreenSlider" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Rgb_Changed"/>
                    <TextBlock x:Name="BlueLabel"/><Slider x:Name="BlueSlider" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Rgb_Changed"/>
                    <WrapPanel x:Name="PalettePanel" Margin="0,4,0,10"/>
                    <Separator Background="#343B43"/>
                    <TextBlock x:Name="BrightnessLabel" Margin="0,10,0,0"/><Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Brightness_Changed"/>
                    <UniformGrid Columns="2" Margin="0,10,0,0"><Button Content="Import" Click="Import_Click" Margin="0,0,3,0"/><Button Content="Export" Click="Export_Click" Margin="3,0,0,0"/></UniformGrid>
                    <TextBlock Text="Apply saves and updates your lighting. Idle and startup settings save immediately." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock x:Name="StatusText" Text="Checking keyboard…" TextWrapping="Wrap"/><TextBlock x:Name="DirtyText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
            <Button Grid.Column="1" Content="Reconnect" Click="Reconnect_Click" Margin="0,0,8,0"/>
            <Button x:Name="ApplyButton" Grid.Column="2" Content="Apply &amp; save" Background="#82EB71" Foreground="#101A11" BorderBrush="#82EB71" FontWeight="SemiBold" Padding="20,9" Click="Apply_Click"/>
        </Grid>
    </Grid>
</Window>
